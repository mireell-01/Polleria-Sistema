{
  "name": "polleria-sistema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "rules:build": "node scripts/build-order-rules.mjs",
    "test": "node --test tests/order-model.test.mjs",
    "test:database": "npx firebase-tools emulators:exec --only database --project demo-polleria-sistema \"node --test --test-concurrency=1 tests/order-model.test.mjs tests/database.test.mjs tests/orders.test.mjs\"",
    "publicar": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
